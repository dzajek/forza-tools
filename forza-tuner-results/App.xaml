<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ForzaTunerResults.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ForzaTunerResults">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->
            <Style x:Name="ListViewStyle" TargetType="ListView">
                <Setter Property="BorderBrush" Value="{ThemeResource AccentAAFillColorDisabled}" />
            </Style>
            <Style x:Name="LabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
