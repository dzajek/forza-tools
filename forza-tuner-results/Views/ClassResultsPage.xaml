<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ForzaTunerResults.Views.ClassResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ForzaTunerResults.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:ForzaTunerResults.ViewModel"
    xmlns:datamodel="using:ForzaTunerResults.DataModel"
    xmlns:viewutils="using:ForzaTunerResults.Views.ViewUtils"
    d:DataContext="{d:DesignInstance Type=viewmodel:ClassResultsPageViewModel}"
    mc:Ignorable="d">

    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="ResultListItemTemplate" x:DataType="datamodel:Result">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"  />
                        <ColumnDefinition Width="150"  />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Stretch">
                        <Run Text="{x:Bind CarYear}" />
                        <Run Text="{x:Bind CarManufacturer}" />
                        <Run Text="{x:Bind CarModel}" />
                    </TextBlock>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        HorizontalTextAlignment="End"
                        Text="{x:Bind viewutils:Formatters.FormatTimeSpan(Raw.TimeTaken)}"
                    />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        HorizontalTextAlignment="End">
                        <Run Text="{x:Bind viewutils:Formatters.FormatDouble2(AverageSpeed)}" />
                        <Run Text="km/h" />
                    </TextBlock>

                </Grid>
            </DataTemplate>
        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"  />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Column="0" Grid.Row="0"
            Grid.ColumnSpan="2"
            Style="{StaticResource TitleTextBlockStyle}"
            Margin="36, 40, 36, 36">
            <Run Text="{x:Bind ViewModel.CurrentCarClass.Name, Mode=OneWay}" />
            <Run Text="{x:Bind ViewModel.CurrentTrack.Name, Mode=OneWay}"/>
            <Run Text="{x:Bind viewutils:Formatters.FormatDouble2(ViewModel.CurrentTrack.Length), Mode=OneWay}"/>
            <Run Text="km" />

        </TextBlock>

        <CommandBar
            Grid.Column="0"
            Grid.Row="1"
            Grid.ColumnSpan="2"/>

        <ListView
            x:Name="ResultsListView"
            Grid.Column="0"
            Grid.Row="2"
            Style="{StaticResource ListViewStyle}"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            ItemTemplate="{StaticResource ResultListItemTemplate}"
            ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
        >
            <ListView.Header>
                <Grid Margin="16,12" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"  />
                        <ColumnDefinition Width="150"  />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Text="Car"
                            FontWeight="Bold"
                        />
                    <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            HorizontalTextAlignment="End"
                            Text="Time Taken"
                            FontWeight="Bold"
                        />
                    <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            HorizontalTextAlignment="End"
                            Text="Speed"
                            FontWeight="Bold"
                        />
                </Grid>
            </ListView.Header>  
        </ListView>

    </Grid>
</Page>
