<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ForzaTunerResults.Views.TracksDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ForzaTunerResults.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:ForzaTunerResults.ViewModel"
    xmlns:datamodel="using:ForzaTunerResults.DataModel"
    xmlns:utils="using:ForzaTunerResults.ViewModel.Utils"
    d:DataContext="{d:DesignInstance Type=viewmodel:TracksDataViewModel}"
    mc:Ignorable="d">

    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="TrackListItemTemplate" x:DataType="datamodel:TrackDescription">
                <Grid Margin="0,5,0,5" ColumnSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"  />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="{x:Bind Name}" />
                    
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind TypeName}" />
                   
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Text="{x:Bind Length}" />

                    <TextBlock
                        Grid.Column="3"
                        Text="km" />

                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <CommandBar
            Background="Transparent"
            DefaultLabelPosition="Right"
            HorizontalAlignment="Left"
            Grid.ColumnSpan="2">
            <CommandBar.PrimaryCommands>
                <AppBarButton Icon="Add" Label="Add" Command="{x:Bind ViewModel.AddTrackCommand}" />
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <ListView
            x:Name="TrackListView"
            Grid.Row="1"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Visibility="{x:Bind utils:Functions.GetListVisibility(ViewModel.Tracks, x:False), Mode=OneWay}"
            Style="{StaticResource ListViewStyle}"
            ItemTemplate="{StaticResource TrackListItemTemplate}"
            ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
        />

        <TextBlock
            x:Name="NoTracksTextBlock"
            Grid.Row="1"
            Text="No tracks available"
            VerticalAlignment="Top"
            FontStyle="Italic"
            HorizontalAlignment="Center"
            Visibility="{x:Bind utils:Functions.GetListVisibility(ViewModel.Tracks, x:True), Mode=OneWay}"
        />

    </Grid>
</Page>
