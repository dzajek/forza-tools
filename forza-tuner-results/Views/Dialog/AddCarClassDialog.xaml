<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ForzaTunerResults.Views.Dialog.AddCarClassDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ForzaTunerResults.Views.Dialog"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:ForzaTunerResults.ViewModel.Dialog"
    xmlns:utils="using:ForzaTunerResults.ViewModel.Utils"
    d:DataContext="{d:DesignInstance Type=viewmodel:AddCarClassDialogViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <utils:DoubleToIntConverter x:Key="DoubleToIntConverter" />
    </Page.Resources>

    <Grid RowSpacing="10" ColumnSpacing="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Text="Letter"
            Grid.Column="0"
            Grid.Row="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
        />

        <TextBox
            Text="{x:Bind ViewModel.Letter, Mode=TwoWay}"
            Grid.Column="1"
            Grid.Row="0"
        />


        <TextBlock
            Text="PI Limit"
            Grid.Column="0"
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
        />

        <NumberBox
            x:Name="YearBox"
            Value="{x:Bind ViewModel.PiLimit, Mode=TwoWay, Converter={StaticResource DoubleToIntConverter}}"
            SpinButtonPlacementMode="Hidden"
            VerticalAlignment="Center" 
            HorizontalAlignment="Stretch"
            Grid.Column="1"
            Grid.Row="1"
        />

    </Grid>
</Page>
