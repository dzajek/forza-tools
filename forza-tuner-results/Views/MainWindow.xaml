<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ForzaTunerResults.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:utils="using:ForzaTunerResults.Views.ViewUtils"
    xmlns:model="using:ForzaTunerResults.DataModel"
    Title="Forza Tuner Results">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="CarClassMenuItemTemplate" x:DataType="model:CarClass" >
                <NavigationViewItem
                    Icon="List"
                    Content="{x:Bind Name}"
                    ToolTipService.ToolTip="{x:Bind Name}"
                    Tag="{x:Bind}"
                />
            </DataTemplate>

            <DataTemplate x:Key="StringMenuItemTemplate" x:DataType="x:String" >
                <NavigationViewItem
                    Icon="List"
                    Content="{x:Bind}"
                    ToolTipService.ToolTip="{x:Bind}"
                    Tag="{x:Bind}"
                />
            </DataTemplate>

            <utils:MenuItemTemplateSelector
                x:Key="selector"
                CarClassMenuItemTemplate="{StaticResource CarClassMenuItemTemplate}"
                StringMenuItemTemplate="{StaticResource StringMenuItemTemplate}"
            />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="titleBar"
            Title="Forza Tuner Results"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested"
        />

        <NavigationView
            PaneTitle="Classes"
            x:Name="mainNav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            MenuItemTemplateSelector="{StaticResource selector}"
            MenuItemsSource="{x:Bind ViewModel.CarMenuItems}"
            FooterMenuItemsSource="{x:Bind ViewModel.FooterMenuItems}"
            ItemInvoked="NavigationView_ItemInvoked">

            <Frame x:Name="rootFrame" Grid.Row="1" />
        </NavigationView>
    </Grid>
</Window>
