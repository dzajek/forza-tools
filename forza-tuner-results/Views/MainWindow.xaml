<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ForzaTunerResults.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:utils="using:ForzaTunerResults.Views.ViewUtils"
    xmlns:model="using:ForzaTunerResults.DataModel"
    Title="Forza Tuner Results"
    Closed="MainWindow_Closed">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Loaded="Grid_Loaded" x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="MainTitleBar"
            Title="Forza Tuner Results"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="MainPaneToggleRequested"
        />

        <NavigationView
            PaneTitle="Classes"
            x:Name="MainNav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            MenuItemsSource="{x:Bind ViewModel.MainNavigationItems, Mode=OneWay}"
            FooterMenuItemsSource="{x:Bind ViewModel.FooterMenuItems, Mode=OneWay}"
            SelectionChanged="NavigationItemSelectionChanged">

            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="model:NavigationItem">
                    <NavigationViewItem
                        Icon="List"
                        Content="{x:Bind Label}"
                        ToolTipService.ToolTip="{x:Bind Label}"
                    />      
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <Frame x:Name="RootFrame" Grid.Row="1" />
        </NavigationView>
    </Grid>
</Window>
