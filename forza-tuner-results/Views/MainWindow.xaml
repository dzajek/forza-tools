<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ForzaTunerResults.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:local="using:ForzaTunerResults.Views"
    xmlns:model="using:ForzaTunerResults.DataModel"
    Title="Forza Tuner Results">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    
    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="CarClassItemTemplate" x:DataType="model:CarClass" >
                <NavigationViewItem Icon="Download" Content="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}" />
            </DataTemplate>

            <local:MenuItemTemplateSelector x:Key="selector" CarClassItemTemplate="{StaticResource CarClassItemTemplate}" />
        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="titleBar"
            Title="Forza Tuner Results"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested"
        />

        <NavigationView 
            Header="Navigation view text"
            PaneTitle="Classes"
            x:Name="mainNav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            MenuItemTemplateSelector="{StaticResource selector}"
            MenuItemsSource="{x:Bind CarClasses, Mode=OneWay}"/>
    </Grid>

</Window>
