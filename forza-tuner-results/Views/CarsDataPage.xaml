<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ForzaTunerResults.Views.CarsDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ForzaTunerResults.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:ForzaTunerResults.ViewModel"
    xmlns:datamodel="using:ForzaTunerResults.DataModel"
    xmlns:utils="using:ForzaTunerResults.ViewModel.Utils"
    xmlns:src="using:ForzaTunerResults.Views.Component"
    d:DataContext="{d:DesignInstance Type=viewmodel:CarsDataViewModel}"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Grid RowSpacing="10" ColumnSpacing="10">
        <Grid.Resources>
            <DataTemplate x:Key="CarListItemTemplate" x:DataType="datamodel:Car">
                <TextBlock Margin="0,5,0,5">
                    <Run Text="{x:Bind Year}" />
                    
                    <Run Text="{x:Bind Manufacturer}" />
                    
                    <Run Text="{x:Bind Model}" />
                </TextBlock>
            </DataTemplate>
            
            <DataTemplate x:Key="TuneListItemTemplate" x:DataType="datamodel:Tune">
                <src:TuneListItem Tune="{x:Bind}" />
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"  />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <CommandBar
            Background="Transparent"
            DefaultLabelPosition="Right"
            HorizontalAlignment="Left"
            Grid.ColumnSpan="2">
            <CommandBar.PrimaryCommands>
                <AppBarButton Icon="Add" Label="Add Car" Command="{x:Bind ViewModel.AddCarCommand}" />
                <AppBarButton Icon="Add" Label="Add Tune" Command="{x:Bind ViewModel.AddTuneCommand}" CommandParameter="{x:Bind ViewModel.SelectedCar, Mode=OneWay}"/>
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <ListView
            x:Name="CarListView"
            Grid.Row="1"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Visibility="{x:Bind utils:Functions.GetListVisibility(ViewModel.Cars, x:False), Mode=OneWay}"
            Style="{StaticResource ListViewStyle}"
            ItemTemplate="{StaticResource CarListItemTemplate}"
            ItemsSource="{x:Bind ViewModel.Cars, Mode=OneWay}"
            SelectedValue="{x:Bind ViewModel.SelectedCar, Mode=TwoWay}"
        />

        <TextBlock
            x:Name="NoCarsTextBlock"
            Grid.Row="1"
            Text="No cars available"
            FontStyle="Italic"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Visibility="{x:Bind utils:Functions.GetListVisibility(ViewModel.Cars, x:True), Mode=OneWay}"
        />

        <ListView
            x:Name="TunesListView"
            Grid.Column="1" Grid.Row="1"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Visibility="{x:Bind utils:Functions.GetListVisibility(ViewModel.SelectedCar, ViewModel.Tunes, x:False), Mode=OneWay}"
            Style="{StaticResource ListViewStyle}"
            ItemTemplate="{StaticResource TuneListItemTemplate}"
            ItemsSource="{x:Bind ViewModel.Tunes, Mode=OneWay}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Enabled"
            ScrollViewer.VerticalScrollMode="Enabled"
        />

        <TextBlock
            x:Name="NoTunesTextBlock"
            Grid.Column="1" Grid.Row="1"
            Text="No tunes found for this car"
            Visibility="{x:Bind utils:Functions.GetListVisibility(ViewModel.SelectedCar, ViewModel.Tunes, x:True), Mode=OneWay}"
            FontStyle="Italic"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
        />

    </Grid>
</Page>
