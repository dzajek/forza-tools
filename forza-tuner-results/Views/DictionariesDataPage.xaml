<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ForzaTunerResults.Views.OthersDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ForzaTunerResults.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:ForzaTunerResults.ViewModel"
    xmlns:datamodel="using:ForzaTunerResults.DataModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:DictionariesPageViewModel}"
    mc:Ignorable="d">

    <Grid ColumnSpacing="20">
        <Grid.Resources>
            <Thickness x:Key="labelMargin" Left="20" Right="0" Top="0" Bottom="0"></Thickness>
            
            <DataTemplate x:Key="DictionaryItemListItemTemplate" x:DataType="datamodel:DictionaryItem">
                <TextBlock Margin="0,5,0,5" Text="{x:Bind Name}" />
            </DataTemplate>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Column="0" Grid.Row="0"
            Margin="{StaticResource labelMargin}"
            VerticalAlignment="Center">Tires</TextBlock>
        
        <TextBlock
            Grid.Column="2" Grid.Row="0"
            Margin="{StaticResource labelMargin}"
            VerticalAlignment="Center">Track types</TextBlock>
        
        <TextBlock
            Grid.Column="4" Grid.Row="0"
            Margin="{StaticResource labelMargin}"
            VerticalAlignment="Center">Suspension</TextBlock>
        
        <TextBlock
            Grid.Column="0" Grid.Row="3"
            Margin="{StaticResource labelMargin}"
            VerticalAlignment="Center">Drivetrain</TextBlock>
        
        <TextBlock
            Grid.Column="2" Grid.Row="3"
            Margin="{StaticResource labelMargin}"
            VerticalAlignment="Center">Gearbox</TextBlock>
        
        <TextBlock
            Grid.Column="4" Grid.Row="3"
            Margin="{StaticResource labelMargin}"
            VerticalAlignment="Center">Aero</TextBlock>


        <CommandBar
            Grid.Column="1" Grid.Row="0"
            DefaultLabelPosition="Right"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
            <CommandBar.PrimaryCommands>
                <AppBarButton Icon="Add" Label="Add tires" Command="{x:Bind ViewModel.AddTiresCommand}"/>
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <CommandBar
            Grid.Column="3" Grid.Row="0"
            DefaultLabelPosition="Right"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
            <CommandBar.PrimaryCommands>
                <AppBarButton Icon="Add" Label="Add track type" Command="{x:Bind ViewModel.AddTrackTypeCommand}"/>
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <CommandBar
            Grid.Column="5" Grid.Row="0"
            DefaultLabelPosition="Right"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
            <CommandBar.PrimaryCommands>
                <AppBarButton Icon="Add" Label="Add suspension" Command="{x:Bind ViewModel.AddSuspensionCommand}"/>
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <CommandBar
            Grid.Column="1" Grid.Row="3"
            DefaultLabelPosition="Right"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
            <CommandBar.PrimaryCommands>
                <AppBarButton Icon="Add" Label="Add drivetrian" Command="{x:Bind ViewModel.AddDrivetrainCommand}" />
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <CommandBar
            Grid.Column="3" Grid.Row="3"
            DefaultLabelPosition="Right"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
            <CommandBar.PrimaryCommands>
                <AppBarButton Icon="Add" Label="Add gearbox" Command="{x:Bind ViewModel.AddGearboxCommand}" />
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <CommandBar
            Grid.Column="5" Grid.Row="3"
            DefaultLabelPosition="Right"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
            <CommandBar.PrimaryCommands>
                <AppBarButton Icon="Add" Label="Add aero" Command="{x:Bind ViewModel.AddAeroCommand}" />
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <ListView
            Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
            x:Name="TiresItemsListView"
            BorderThickness="1"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
            ItemTemplate="{StaticResource DictionaryItemListItemTemplate}"
            ItemsSource="{x:Bind ViewModel.GlobalStore.Tires, Mode=OneWay}"
        />
        
        <ListView
            Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="2"
            x:Name="TrackTypesItemsListView"
            BorderThickness="1"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
            ItemTemplate="{StaticResource DictionaryItemListItemTemplate}"
            ItemsSource="{x:Bind ViewModel.GlobalStore.TrackTypes, Mode=OneWay}"
        />
        
        <ListView
            Grid.Column="4" Grid.Row="1" Grid.ColumnSpan="2"
            x:Name="SuspensionItemsListView"
            BorderThickness="1"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
            ItemTemplate="{StaticResource DictionaryItemListItemTemplate}"
            ItemsSource="{x:Bind ViewModel.GlobalStore.Suspensions, Mode=OneWay}"
        />
        
        <ListView
            Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2"
            x:Name="DrivetrainItemsListView"
            BorderThickness="1"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
            ItemTemplate="{StaticResource DictionaryItemListItemTemplate}"
            ItemsSource="{x:Bind ViewModel.GlobalStore.Drivetrains, Mode=OneWay}"
        />
        
        <ListView
            Grid.Column="2" Grid.Row="4" Grid.ColumnSpan="2"
            x:Name="GearboxItemsListView"
            BorderThickness="1"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
            ItemTemplate="{StaticResource DictionaryItemListItemTemplate}"
            ItemsSource="{x:Bind ViewModel.GlobalStore.Gearboxes, Mode=OneWay}"
        />
        
        <ListView
            Grid.Column="4" Grid.Row="4" Grid.ColumnSpan="2"
            x:Name="AeroItemsListView"
            BorderThickness="1"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
            ItemTemplate="{StaticResource DictionaryItemListItemTemplate}"
            ItemsSource="{x:Bind ViewModel.GlobalStore.Aeros, Mode=OneWay}"
        />

    </Grid>
</Page>
