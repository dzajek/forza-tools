<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="thisPage"
    x:Class="ForzaTunerResults.Views.CarClassesDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ForzaTunerResults.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:ForzaTunerResults.ViewModel"
    xmlns:datamodel="using:ForzaTunerResults.DataModel"
    xmlns:utils="using:ForzaTunerResults.ViewModel.Utils"
    d:DataContext="{d:DesignInstance Type=viewmodel:CarClassesDataViewModel}"
    mc:Ignorable="d">

    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="CarClassesListItemTemplate" x:DataType="datamodel:CarClass">
                <TextBlock Margin="0,5,0,5" Text="{x:Bind Name}" />
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"  />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <CommandBar
            Background="Transparent"
            DefaultLabelPosition="Right"
            HorizontalAlignment="Left"
            Grid.ColumnSpan="2">
            <CommandBar.PrimaryCommands>
                <AppBarButton Icon="Add" Label="Add" Command="{x:Bind ViewModel.AddCarClassCommand}" CommandParameter="{x:Bind thisPage}"/>
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <ListView
            x:Name="CarClassesListView"
            BorderThickness="1"
            Grid.Row="1"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Visibility="{x:Bind utils:Functions.GetListVisibility(ViewModel.GlobalStore.CarClasses, x:False), Mode=OneWay}"
            BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
            ItemTemplate="{StaticResource CarClassesListItemTemplate}"
            ItemsSource="{x:Bind ViewModel.GlobalStore.CarClasses, Mode=OneWay}"
        />

        <TextBlock
            x:Name="NoCarClassesTextBlock"
            Grid.Row="1"
            Text="No car classes available"
            VerticalAlignment="Top"
            FontStyle="Italic"
            HorizontalAlignment="Center"
            Visibility="{x:Bind utils:Functions.GetListVisibility(ViewModel.GlobalStore.CarClasses, x:True), Mode=OneWay}"
        />
        
    </Grid>
</Page>
