<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ForzaTunerResults.Views.Component.TuneListItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:format="using:ForzaTunerResults.Views.Utils"
    xmlns:datamodel="using:ForzaTunerResults.DataModel.DTOs"
    d:DataContext="{d:DesignInstance Type=datamodel:Tune}"
    mc:Ignorable="d">

    <Grid Padding="5,20,5,20" ColumnSpacing="10" RowSpacing="20"
      BorderBrush="{ThemeResource AccentAAFillColorDisabled}" BorderThickness="0,1,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" /><!-- CLASS, IsDefault -->
            <ColumnDefinition Width="90" /><!-- LABEL-->
            <ColumnDefinition Width="*" /><!-- -->
            <ColumnDefinition Width="90" /><!-- LABEL -->
            <ColumnDefinition Width="*" /><!-- -->
            <ColumnDefinition Width="90" /><!-- LABEL -->
            <ColumnDefinition Width="*" /><!-- -->
            <ColumnDefinition Width="90" /><!-- LABEL -->
            <ColumnDefinition Width="*" /><!-- -->
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- CLASS -->
        <TextBlock
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Grid.RowSpan="2"
            FontSize="26"
            FontWeight="SemiBold"
            Text="{x:Bind Tune.ClassDescription, Mode=OneWay}" />

        <!-- DEFAULT -->
        <FontIcon
            Grid.Row="2"
            FontFamily="Segoe MDL2 Assets"
            Glyph="&#xE8A5;"
            ToolTipService.ToolTip="Default"
            Visibility="{x:Bind Tune.IsDefault, Mode=OneWay}"/>

        <!-- POWER -->
        <TextBlock
            Text="Power:"
            Grid.Column="1"
            Style="{StaticResource LabelStyle}"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            />

        <TextBlock
            Grid.Column="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Width="60"
            TextAlignment="Right">
                <Run Text="{x:Bind Tune.Power, Mode=OneWay}" />
                <Run Text="HP" />
        </TextBlock>

        <!-- TORQUE -->
        <TextBlock
            Text="Torque:"
            Grid.Column="1" Grid.Row="1"
            Style="{StaticResource LabelStyle}"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            />

        <TextBlock
            Grid.Column="2" Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Width="60"
            TextAlignment="Right">
                <Run Text="{x:Bind Tune.Torque, Mode=OneWay}" />
                <Run Text="Nm" />
        </TextBlock>

        <!-- Weight -->
        <TextBlock
            Text="Weight:"
            Grid.Column="1" Grid.Row="2"
            Style="{StaticResource LabelStyle}"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            />

        <TextBlock
            Grid.Column="2" Grid.Row="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Width="60"
            TextAlignment="Right">
                <Run Text="{x:Bind Tune.Weight, Mode=OneWay}" />
                <Run Text="kg" />
        </TextBlock>

        <!-- Tires -->
        <TextBlock
            Text="Tires:"
            Grid.Column="3" Grid.Row="0"
            Style="{StaticResource LabelStyle}"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            />

        <TextBlock
            Grid.Column="4" Grid.Row="0"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Text="{x:Bind Tune.Tires, Mode=OneWay}"/>

        <!-- Gearbox -->
        <TextBlock
            Text="Gearbox:"
            Grid.Column="3" Grid.Row="1"
            Style="{StaticResource LabelStyle}"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            />

        <TextBlock
            Grid.Column="4" Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Text="{x:Bind Tune.Gearbox, Mode=OneWay}"/>

        <!-- Engine -->
        <TextBlock
            Text="Engine:"
            Grid.Column="3" Grid.Row="2"
            Style="{StaticResource LabelStyle}"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            />

        <TextBlock
            Grid.Column="4" Grid.Row="2"
            Text="{x:Bind Tune.Engine, Mode=OneWay}" />

        
        <!-- Drivetrain -->
        <TextBlock
            Text="Drivetrain:"
            Grid.Column="5" Grid.Row="0"
            Style="{StaticResource LabelStyle}"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            />

        <TextBlock
            Grid.Column="6" Grid.Row="0"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Text="{x:Bind Tune.Suspension, Mode=OneWay}"/>

        <!-- Suspension -->
        <TextBlock
            Text="Suspension:"
            Grid.Column="5" Grid.Row="1"
            Style="{StaticResource LabelStyle}"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            />

        <TextBlock
            Grid.Column="6" Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Text="{x:Bind Tune.Suspension, Mode=OneWay}"/>
        
        <!-- Lateral Grip -->
        <TextBlock
            Text="Lateral grip:"
            Grid.Column="5" Grid.Row="2"
            Style="{StaticResource LabelStyle}"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            />

        <TextBlock
            Grid.Column="6" Grid.Row="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Text="{x:Bind format:Formatters.FormatDouble2(Tune.LateralGrip), Mode=OneWay}"/>

        <!-- Front Aero -->
        <TextBlock
            Text="Front Aero:"
            Grid.Column="7" Grid.Row="0"
            Style="{StaticResource LabelStyle}"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            />

        <TextBlock
            Grid.Column="8" Grid.Row="0"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Text="{x:Bind Tune.FrontAero, Mode=OneWay}"/>

        <!-- Rear Aero -->
        <TextBlock
            Text="Rear Aero:"
            Grid.Column="7" Grid.Row="1"
            Style="{StaticResource LabelStyle}"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            />

        <TextBlock
            Grid.Column="8" Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Text="{x:Bind Tune.RearAero, Mode=OneWay}"/>

        <!-- Power to Weight -->
        <TextBlock
            Text="PTW:"
            Grid.Column="7" Grid.Row="2"
            Style="{StaticResource LabelStyle}"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            />

        <TextBlock
            Grid.Column="8" Grid.Row="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Text="{x:Bind format:Formatters.FormatDouble2(Tune.PowerToWeight), Mode=OneWay}"/>
        
    </Grid>
</UserControl>
